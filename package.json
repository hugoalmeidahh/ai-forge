{
  "name": "@hugoalmeidahh/ai-forge",
  "version": "3.0.0",
  "description": "Standards, skills and functions for AI-assisted software delivery across stacks.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "forge": "bin/forge.js"
  },
  "scripts": {
    "test": "node --test",
    "validate": "node bin/forge.js validate",
    "pack:check": "npm pack --dry-run",
    "references:check": "node bin/forge.js sync-references",
    "references:sync": "node bin/forge.js sync-references --write"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "lib",
    "core",
    "standards",
    "backend-nestjs",
    "backend-node",
    "backend-golang",
    "frontend-react",
    "frontend-vue",
    "template-stack",
    "SKILL.md",
    "README.md",
    "CHANGELOG.md",
    "SPEC.md",
    "frontend",
    "frontend-nextjs",
    "frontend-nuxt",
    "frontend-angular",
    "frontend-svelte",
    "frontend-astro",
    "frontend-html-css",
    "quality",
    "design",
    "integrations",
    "artifacts",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs"
  ]
}
